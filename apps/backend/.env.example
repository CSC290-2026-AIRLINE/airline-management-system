PORT=8080
NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/airline_db"

# Clerk (frontend authentication provider) - one separate Clerk application per app
# Get the development secret keys (sk_test_...) from the Infra Leads. Never commit them.
CLERK_SECRET_KEY_CUSTOMER=""
CLERK_SECRET_KEY_STAFF=""

# Our own access/refresh tokens
# Generate ACCESS_TOKEN_SECRET with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Feature 5 payments: "fake" (default) needs no Stripe account; "stripe" needs the test-mode keys below
PAYMENT_PROVIDER="fake"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Feature 5 dev test tools (payment sandbox + sample crew data). Development only: refused when NODE_ENV=production.
# TODO(F5-dev): remove this setting with the dev tools before the PR merges.
PAYMENT_DEV_TOOLS="false"

# Lets a browser GET run src/db/seed.ts (GET /api/dev/seed). Development only: refused when NODE_ENV=production.
DEV_SEED_ENABLED="false"

# Optional private photo storage for Feature 10 lost-baggage reports (local SeaweedFS)
S3_ENDPOINT="http://localhost:8333"
S3_ACCESS_KEY="devaccesskey"
S3_SECRET_KEY="devsecretkey"

# Onboard products (F12)
# Dev and test only. F12 follows the project simulation clock; when this is set,
# F12 reads this fixed time instead (for example to jump past an order cutoff).
# Leave it empty otherwise.
SIMULATION_NOW_ISO=""
# The F12 scheduled job: it generates the catering order at the cutoff, expires
# the unpaid orders and writes off the expired batches. Set to "false" to switch
# it off; the interval is in seconds.
F12_SCHEDULER_ENABLED="true"
F12_SCHEDULER_INTERVAL_SECONDS=60
