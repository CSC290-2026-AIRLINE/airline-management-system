PORT=8080
NODE_ENV="development"

DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/airline_db"

# Clerk (frontend authentication provider) - one separate Clerk application per app
# Get the development secret keys (sk_test_...) from the Infra Leads. Never commit them.
CLERK_SECRET_KEY_CUSTOMER=""
CLERK_SECRET_KEY_STAFF=""

# Our own access/refresh tokens
# Generate ACCESS_TOKEN_SECRET with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=""
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional private photo storage for Feature 10 lost-baggage reports (local SeaweedFS)
S3_ENDPOINT="http://localhost:8333"
S3_ACCESS_KEY="devaccesskey"
S3_SECRET_KEY="devsecretkey"
