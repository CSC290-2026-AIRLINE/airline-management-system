  aircraft_type_id                                    String                   @db.Uuid
  entry_into_service_date                             DateTime                 @db.Date
  retired_on                                          DateTime?                @db.Date
  base_airport_code                                   String
  created_at                                          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                          DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at                                          DateTime?                @db.Timestamptz(6)
  aircraft_type                                       aircraft_type            @relation(fields: [aircraft_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  airport                                             airport                  @relation(fields: [base_airport_code], references: [iata_code], onDelete: NoAction, onUpdate: NoAction, map: "aircraft_base_airport_fk")
  aircraft_maintenance                                aircraft_maintenance[]
  aircraft_operating_day                              aircraft_operating_day[]
  aircraft_status_period                              aircraft_status_period[]
  aircraft_stock                                      aircraft_stock[]
  aircraft_turnaround                                 aircraft_turnaround[]
  flight                                              flight[]
  flight_event_flight_event_new_aircraft_idToaircraft flight_event[]           @relation("flight_event_new_aircraft_idToaircraft")
  flight_event_flight_event_old_aircraft_idToaircraft flight_event[]           @relation("flight_event_old_aircraft_idToaircraft")
  schedule_approval                                   schedule_approval[]
  stock_movement                                      stock_movement[]
  stock_transfer                                      stock_transfer[]

  @@index([base_airport_code], map: "aircraft_base_idx")
  @@index([aircraft_type_id], map: "aircraft_type_idx")
}

