// Generated with `prisma db pull` from a database migrated by src/db/schema.sql. After every re-pull, change these
// 12 back-relations to lists by hand. The first 5 fail `prisma validate`
// otherwise: Prisma rejects a one-to-one relation over a composite foreign key unless the composite is unique, and the
// database does not need that extra unique:
//   fare_quote.promo_redemption         ->  promo_redemption[]
//   user.customer                       ->  customer[]
//   user.staff                          ->  staff[]
//   booking_coupon.check_in             ->  check_in[]
//   booking_segment.booking_change_booking_change_old_segment_id_booking_idTobooking_segment  ->  booking_change[]
// The other 7 are read as one-to-one from a partial unique, although the table holds more rows:
//   boarding_pass.boarding_event        ->  boarding_event[]        (boarding_event_final_uq: one boarded or no-show, plus rejected scans)
//   checked_bag.found_bag               ->  found_bag[]             (found_bag_checked_bag_uq skips continued_with_flight rows)
//   complaint_case.case_compensation    ->  case_compensation[]     (case_compensation_live_uq skips failed decisions)
//   booking_coupon.product_order_line   ->  product_order_line[]    (product_order_line_meal_uq covers live meal lines only)
//   cargo_booking.cargo_shipment_event  ->  cargo_shipment_event[]  (cargo_shipment_event_first_uq covers the first event only)
//   payment.receipt                     ->  receipt[]               (receipt_one_per_payment_uq skips refund receipts)
//   compensation_voucher.payment        ->  payment[]               (payment_voucher_uq skips failed and expired payments)
// Prisma Client offers findUnique on partial uniques, but they cover only some rows: find a pass's boarded or no-show
// event, a booking passenger's live check_in, a checked bag's live found_bag, a case's live compensation, a coupon's held
// or assigned seat, a coupon's live meal line, a coupon's upgrade, a member's lounge visit on a flight, a booking's active
// insurance policy, a cargo booking's first or accepted event and a payment's open or authorised attempt and its payment
// receipt with findFirst and the index's condition.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model aircraft {
