  purpose                                                                             String
  flight_id                                                                           String?                   @db.Uuid
  pattern_id                                                                          String?                   @db.Uuid
  route_id                                                                            String                    @db.Uuid
  flight_number                                                                       String
  service_date                                                                        DateTime                  @db.Date
  aircraft_id                                                                         String                    @db.Uuid
  proposed_dep_at                                                                     DateTime                  @db.Timestamptz(6)
  proposed_arr_at                                                                     DateTime                  @db.Timestamptz(6)
  approver_type                                                                       String
  approver_airport                                                                    String?
  approver_partner_airline                                                            String?
  status                                                                              String                    @default("pending")
  reject_reason                                                                       String?
  response_note                                                                       String?
  previous_approval_id                                                                String?                   @db.Uuid
  covered_by_approval_id                                                              String?                   @db.Uuid
  revision                                                                            Int                       @default(1)
  requested_by                                                                        String?                   @db.Uuid
  requested_at                                                                        DateTime                  @db.Timestamptz(6)
  respond_by                                                                          DateTime?                 @db.Timestamptz(6)
  responded_by                                                                        String?                   @db.Uuid
  responded_at                                                                        DateTime?                 @db.Timestamptz(6)
  resulting_flight_id                                                                 String?                   @db.Uuid
  created_at                                                                          DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                                          DateTime                  @default(now()) @db.Timestamptz(6)
  aircraft                                                                            aircraft                  @relation(fields: [aircraft_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "schedule_approval_aircraft_fk")
  airport                                                                             airport?                  @relation(fields: [approver_airport], references: [iata_code], onDelete: NoAction, onUpdate: NoAction)
  partner_airline                                                                     partner_airline?          @relation(fields: [approver_partner_airline], references: [code], onDelete: NoAction, onUpdate: NoAction)
  schedule_approval_schedule_approval_covered_by_approval_idToschedule_approval       schedule_approval?        @relation("schedule_approval_covered_by_approval_idToschedule_approval", fields: [covered_by_approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_schedule_approval_schedule_approval_covered_by_approval_idToschedule_approval schedule_approval[]       @relation("schedule_approval_covered_by_approval_idToschedule_approval")
  flight_schedule_approval_flight_idToflight                                          flight?                   @relation("schedule_approval_flight_idToflight", fields: [flight_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flight_pattern                                                                      flight_pattern?           @relation(fields: [pattern_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule_approval_schedule_approval_previous_approval_idToschedule_approval         schedule_approval?        @relation("schedule_approval_previous_approval_idToschedule_approval", fields: [previous_approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_schedule_approval_schedule_approval_previous_approval_idToschedule_approval   schedule_approval[]       @relation("schedule_approval_previous_approval_idToschedule_approval")
  staff_schedule_approval_requested_byTostaff                                         staff?                    @relation("schedule_approval_requested_byTostaff", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_schedule_approval_responded_byTostaff                                         staff?                    @relation("schedule_approval_responded_byTostaff", fields: [responded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flight_schedule_approval_resulting_flight_idToflight                                flight?                   @relation("schedule_approval_resulting_flight_idToflight", fields: [resulting_flight_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  route                                                                               route                     @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule_approval_offer                                                             schedule_approval_offer[]

  @@unique([flight_number, service_date], map: "schedule_approval_live_uq", where: raw("(status = ANY (ARRAY['pending'::text, 'approved'::text, 'alternative_offered'::text]))"))
  @@index([flight_id], map: "schedule_approval_flight_idx", where: raw("(flight_id IS NOT NULL)"))
  @@index([flight_number, service_date], map: "schedule_approval_flight_number_idx")
  @@index([requested_at], map: "schedule_approval_pending_idx", where: raw("(status = 'pending'::text)"))
  @@index([previous_approval_id], map: "schedule_approval_previous_idx", where: raw("(previous_approval_id IS NOT NULL)"))
  @@index([resulting_flight_id], map: "schedule_approval_resulting_flight_idx", where: raw("(resulting_flight_id IS NOT NULL)"))
  @@index([route_id], map: "schedule_approval_route_idx")
}

