{
  "name": "airline-management-system",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"pnpm --filter ./apps/backend dev\" \"pnpm --filter ./apps/frontend dev\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}